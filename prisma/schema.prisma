// Commerce schema.
//
// Two conventions hold throughout:
//
//   MONEY is integer paise. ₹15,000.00 is stored as 1500000. Never Float or
//   Decimal-as-float — a rounding drift inside an order total is a support
//   problem, not a rounding problem.
//
//   SNAPSHOTS. Anything historical (order lines, addresses on an order) copies
//   the values it needs at the time it is written. Reconstructing a two-year-old
//   order must never depend on the current product record.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Coarse account type. Drives the storefront/admin split and route guards.
/// Fine-grained capability lives in Role -> Permission below; this exists so
/// the common check ("is this an admin at all?") is one indexed column.
enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// Erased on request. The row survives because orders point at it; the
  /// personal data does not. See prisma/schema — User.anonymisedAt.
  ANONYMISED
}

/// One users table for customers and staff alike (spec §4) — no second
/// authentication system. Separation of powers is enforced by role and
/// permission checks on every admin endpoint, never by which table you are in.
model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  phone         String?
  passwordHash  String
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  lastLoginAt   DateTime?
  /// When the account's personal data was erased. Set once and never cleared —
  /// it is the record that the erasure happened, which is itself required.
  anonymisedAt  DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles         UserRoleAssignment[]
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  statusChanges OrderStatusHistory[]

  passwordResets   PasswordResetToken[]
  consents         Consent[]
  wishlist         WishlistItem[]
  reviews          Review[]
  notifications    Notification[]
  notificationPrefs NotificationPreference[]
  returnRequests   ReturnRequest[]
  couponRedemptions CouponRedemption[]
  checkoutSessions CheckoutSession[]
  internalNotes    CustomerNote[]        @relation("CustomerNoteSubject")
  authoredNotes    CustomerNote[]        @relation("CustomerNoteAuthor")

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  /// Seeded roles cannot be deleted through the admin UI.
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique
  group String
  label String

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model UserRoleAssignment {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Refresh tokens are stored hashed — a database leak must not yield usable
/// sessions. `family` ties a rotation chain together so reuse of an already
/// rotated token can revoke the whole lineage.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

/// `parentId` is present from day one so categories can become hierarchical
/// without a migration, even though the first admin UI is single-level.
model Category {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  image       String?
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)
  parentId    String?
  /// Per-page SEO overrides; fall back to name/description when unset.
  seoTitle       String?
  seoDescription String?
  seoNoindex     Boolean     @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  coupons  CouponCategory[]

  @@index([status, sortOrder])
  @@index([parentId])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  /// Publishes automatically once `scheduledFor` passes.
  SCHEDULED
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  description      String
  shortDescription String?
  sku              String        @unique
  /// paise
  price            Int
  /// paise; the "was" price. Discount % is always derived, never stored.
  compareAtPrice   Int?
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  categoryId       String?
  publishedAt      DateTime?
  /// Set with status=SCHEDULED; a job flips it to ACTIVE when this passes.
  scheduledFor     DateTime?

  /// Material and care copy the PDP requires (FR-03.1).
  material         String?
  careInstructions String?

  /// Per-page SEO overrides; fall back to name/shortDescription when unset.
  seoTitle       String?
  seoDescription String?
  seoNoindex     Boolean @default(false)

  /// Denormalised review aggregates, recomputed when a review is moderated.
  /// Display only — never used in a money calculation.
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]
  wishlist WishlistItem[]
  coupons  CouponProduct[]
  showcase ShowcaseProduct[]

  @@index([status])
  @@index([categoryId])
  @@index([status, featured])
  @@index([status, publishedAt])
  @@map("products")
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

/// Every product has at least one variant, including single-SKU products (a
/// "Default" variant). That keeps cart lines, order lines and inventory keyed
/// off one thing instead of branching on whether variants exist.
model ProductVariant {
  id        String        @id @default(cuid())
  productId String
  name      String
  sku       String        @unique
  /// paise; null means inherit Product.price
  price     Int?
  /// Shipping weight. Null falls back to the store-wide default in settings.
  weightGrams Int?
  status    VariantStatus @default(ACTIVE)
  position  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]
  /// Structured options (Size: M, Colour: Sage) so listings can facet on them.
  attributes VariantAttributeValue[]
  wishlist   WishlistItem[]

  @@index([productId])
  @@index([status])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

enum InventoryMovementType {
  INITIAL_STOCK
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
}

/// Stock lives here, not as a loose number on the product (spec §14).
/// Every change to `availableStock` is written together with a movement row in
/// the same transaction, so the ledger always explains the balance.
model Inventory {
  id                String   @id @default(cuid())
  variantId         String   @unique
  availableStock    Int      @default(0)
  reservedStock     Int      @default(0)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@index([availableStock])
  @@map("inventory")
}

model InventoryMovement {
  id          String                @id @default(cuid())
  inventoryId String
  type        InventoryMovementType
  /// Signed: negative for SALE and DAMAGE, positive for restocks.
  quantity    Int
  /// Stock level after applying this movement — makes the ledger auditable
  /// without replaying the whole history.
  balanceAfter Int
  reason      String?
  /// Loose link to whatever caused it, e.g. ("ORDER", orderId).
  referenceType String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime            @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String   @default("IN")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

/// A cart is either a guest cart (token only) or a user cart (userId set).
/// On login the guest cart is merged into the user's cart and then discarded.
model Cart {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?  @unique
  /// The code the shopper typed, not the discount. The amount is always
  /// re-derived from the Coupon row, so an edited or expired coupon takes
  /// effect immediately rather than being frozen into the cart.
  couponCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  status      OrderStatus @default(PENDING_PAYMENT)

  /// all paise
  subtotal Int
  discount Int    @default(0)
  shipping Int    @default(0)
  tax      Int    @default(0)
  total    Int
  currency String @default("INR")

  /// Frozen copies — the address rows may later be edited or deleted.
  shippingAddressSnapshot Json
  billingAddressSnapshot  Json?

  /// Coupon applied at checkout. The code is snapshotted so history survives
  /// the coupon being edited or deleted.
  couponId   String?
  couponCode String?

  /// Chosen shipping method, snapshotted for the same reason.
  shippingMethodId   String?
  shippingMethodName String?

  /// Customer-facing note left at checkout.
  notes String?
  /// Staff-only; never returned on customer endpoints.
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  shipments     Shipment[]
  returnRequests ReturnRequest[]
  refunds       Refund[]
  coupon        Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  redemption    CouponRedemption?
  shippingMethod ShippingMethod?     @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  checkoutSession CheckoutSession?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?

  /// Snapshots (spec §26) — never join back to the product to render history.
  productNameSnapshot String
  variantNameSnapshot String?
  sku                 String
  imageUrlSnapshot    String?
  unitPrice           Int
  quantity            Int
  lineTotal           Int

  /// Share of the order discount attributed to this line (FR-13.5). Refunds are
  /// calculated from lineTotal minus this, so a partial return never gives back
  /// more than the customer actually paid.
  discountAllocated Int @default(0)

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  shipmentItems ShipmentItem[]
  returnItems   ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

/// An order may accumulate several payment attempts; the order is only PAID
/// once one of them reaches CAPTURED via verified signature or webhook.
///
/// Card numbers, CVVs, UPI credentials and the like are never stored — only
/// provider references.
model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  providerOrderId   String?
  providerPaymentId String?
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([providerOrderId])
  @@map("payments")
}

enum PaymentTransactionType {
  CREATE
  AUTHORIZE
  CAPTURE
  FAIL
  REFUND
  WEBHOOK
}

model PaymentTransaction {
  id                String                 @id @default(cuid())
  paymentId         String
  type              PaymentTransactionType
  status            PaymentStatus
  amount            Int?
  providerReference String?
  /// Provider response, minus anything sensitive.
  payload           Json?
  createdAt         DateTime               @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_transactions")
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  SKIPPED
}

/// Idempotency ledger for provider webhooks (spec §32). The unique constraint
/// on (provider, eventId) is what makes redelivery a no-op.
model WebhookEvent {
  id          String        @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  status      WebhookStatus @default(RECEIVED)
  payload     Json
  error       String?
  receivedAt  DateTime      @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([provider, eventType])
  @@index([status])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Settings, audit
// ---------------------------------------------------------------------------

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

/// Store configuration, so nothing business-related is hard-coded in the
/// frontend (spec §37). Values are stored as text and cast by `type`.
model Setting {
  id        String      @id @default(cuid())
  key       String      @unique
  value     String
  type      SettingType @default(STRING)
  group     String      @default("general")
  label     String
  updatedAt DateTime    @updatedAt

  @@index([group])
  @@map("settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  /// Never store secrets here.
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// Attributes — the faceting vocabulary (Size, Colour, Fabric …).
//
// Variants own their price and stock; attributes only describe them. Keeping
// the vocabulary in its own table is what makes storefront filters possible
// without parsing variant names.
// ============================================================================

model Attribute {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  /// Rendered as swatches when true (colour), as chips otherwise (size).
  isSwatch     Boolean @default(false)
  /// Exposed as a storefront filter.
  isFilterable Boolean @default(true)
  position     Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  values AttributeValue[]

  @@index([position])
  @@map("attributes")
}

model AttributeValue {
  id          String  @id @default(cuid())
  attributeId String
  value       String
  slug        String
  /// Hex for swatches, e.g. "#838E5E". Ignored for non-swatch attributes.
  colorHex    String?
  position    Int     @default(0)

  attribute Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  VariantAttributeValue[]

  @@unique([attributeId, slug])
  @@index([attributeId, position])
  @@map("attribute_values")
}

/// Join between a variant and the attribute values that define it.
model VariantAttributeValue {
  variantId        String
  attributeValueId String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

// ============================================================================
// Coupons (M13)
//
// A coupon's value is never trusted from the client. The cart sends a code;
// the server re-derives the discount from this row every time, so editing a
// coupon changes future carts but never rewrites placed orders — those keep
// Order.couponCode and the already-computed amounts.
// ============================================================================

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum CouponStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

model Coupon {
  id          String       @id @default(cuid())
  /// Compared case-insensitively at redemption; stored upper-case.
  code        String       @unique
  description String?
  type        DiscountType
  status      CouponStatus @default(DRAFT)

  /// Basis points for PERCENTAGE (1000 = 10%), paise for FIXED, ignored for
  /// FREE_SHIPPING. One integer field — no floats anywhere in money maths.
  value Int

  /// Caps a percentage discount, in paise. Null = uncapped.
  maxDiscount Int?
  /// Cart subtotal required before the coupon applies, in paise.
  minSubtotal Int  @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  /// Null = unlimited. usageCount is incremented inside the order transaction,
  /// so two simultaneous checkouts cannot both take the last one.
  usageLimit        Int?
  usageCount        Int     @default(0)
  perUserLimit      Int?
  /// Only orders from customers who have never ordered before.
  firstOrderOnly    Boolean @default(false)
  /// Excludes products already discounted (price < compareAtPrice).
  excludeDiscounted Boolean @default(false)
  /// Not shown in listings; applies only when typed in.
  isPublic          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    CouponProduct[]
  categories  CouponCategory[]
  redemptions CouponRedemption[]
  orders      Order[]

  @@index([status])
  @@index([endsAt])
  @@map("coupons")
}

/// Restricts a coupon to specific products. No rows = applies to everything.
model CouponProduct {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
  @@map("coupon_products")
}

/// Restricts a coupon to specific categories. No rows = applies to everything.
model CouponCategory {
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
  @@map("coupon_categories")
}

/// One row per successful redemption. orderId is unique so a retried checkout
/// can never double-count, and per-user limits are a count over this table.
model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  /// Paise actually taken off, after caps.
  amount    Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ============================================================================
// Shipping (M21)
// ============================================================================

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  /// ISO-3166-1 alpha-2, e.g. ["IN"].
  countries String[]
  /// Indian state names or PIN prefixes. Empty = the whole country.
  regions   String[]
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)

  /**
   * Serviceability (FR-21.1).
   *
   * When false, an address matching this zone is explicitly NOT deliverable —
   * the zone exists to say no. Because zones are matched in `position` order,
   * a narrow non-serviceable zone at position 0 beats the broad default zone
   * behind it, which is how a PIN blocklist is expressed without a second
   * matching mechanism.
   */
  isServiceable Boolean @default(true)
  /// Shown to the customer when this zone refuses delivery.
  unserviceableMessage String?

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  methods ShippingMethod[]

  @@index([isActive, position])
  @@map("shipping_zones")
}

model ShippingMethod {
  id          String  @id @default(cuid())
  zoneId      String
  name        String
  description String?

  /// Flat rate in paise. Free shipping is simply 0.
  rate        Int  @default(0)
  /// Cart subtotal at or above which this method costs nothing. Null = never.
  freeAbove   Int?
  /// Order subtotal bounds for this method to be offered at all, in paise.
  minSubtotal Int?
  maxSubtotal Int?
  /// Shown to the customer as "3–5 business days".
  minDays     Int?
  maxDays     Int?
  /// Parcel weight this method cannot carry, in grams. Null = no limit.
  /// A basket heavier than this is not offered the method at all (FR-21.2).
  maxWeightGrams Int?

  /// Cash on delivery is a shipping method with an extra fee attached.
  isCod       Boolean @default(false)
  codFee      Int     @default(0)

  /**
   * Which adapter creates shipments for this method. Null means the parcel is
   * booked by hand and an operator enters the tracking number — which is a
   * legitimate configuration, not a missing one.
   */
  provider String?

  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone   ShippingZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  rates  ShippingRate[]
  orders Order[]

  @@index([zoneId, isActive, position])
  @@map("shipping_methods")
}

/**
 * A rate band (FR-21.2).
 *
 * `ShippingMethod.rate` is the flat fallback. When a method has bands, the
 * first band matching the parcel's weight and the basket's value wins, which
 * is how "under 500g costs ₹60, up to 2kg costs ₹120" is expressed.
 *
 * Bounds are inclusive-lower, exclusive-upper, so adjacent bands can share an
 * edge without overlapping. Null means unbounded on that side.
 */
model ShippingRate {
  id       String @id @default(cuid())
  methodId String
  /// Human label for the admin table, e.g. "Up to 500 g".
  label    String?

  minWeightGrams Int?
  maxWeightGrams Int?
  minSubtotal    Int?
  maxSubtotal    Int?

  /// Charge for this band, in paise.
  amount   Int
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  method ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@index([methodId, position])
  @@map("shipping_rates")
}

// ============================================================================
// Fulfilment (M09)
//
// One order can ship in several parcels, so shipments hold their own item rows
// rather than reusing the order lines.
// ============================================================================

enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  /// Carrier reported a problem the parcel can still recover from — a wrong
  /// address, nobody home, weather. Distinct from FAILED, which is the end of
  /// the attempt (FR-21.6).
  EXCEPTION
  FAILED
  RETURNED_TO_ORIGIN
  CANCELLED
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  /// Human-facing, e.g. "PK-1042-S1".
  shipmentNumber String         @unique
  status         ShipmentStatus @default(PENDING)

  carrier        String?
  trackingNumber String?
  /// Full URL the customer can open, built from the carrier's template.
  trackingUrl    String?

  /**
   * Package profile (FR-21.4). One shipment is one parcel in this model — a
   * consignment that needs two boxes is two shipments, which is also how the
   * carrier will bill and track it.
   */
  weightGrams Int?
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?

  /**
   * Provider references (FR-21.3, FR-21.4). All null for a parcel booked by
   * hand. `providerShipmentId` is unique so a carrier callback can find the
   * shipment without trusting anything else in the payload.
   */
  provider           String?
  providerShipmentId String? @unique
  labelUrl           String?

  /// Dispatch data — who handed it over and when it was packed.
  dispatchedBy String?
  packedAt     DateTime?

  shippedAt   DateTime?
  deliveredAt DateTime?
  estimatedAt DateTime?

  /**
   * Set when a carrier event arrived that would have moved this shipment
   * backwards. The event is still recorded, but the status is left alone and
   * an operator is asked to look (M09: out-of-order events cannot move a
   * delivered shipment backwards without review).
   */
  needsReview   Boolean @default(false)
  reviewReason  String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items  ShipmentItem[]
  events ShipmentEvent[]

  @@index([orderId])
  @@index([status])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentItem {
  id          String @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
  @@map("shipment_items")
}

/// Append-only tracking trail. Carrier webhooks write here; nothing edits it.
model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  /// Our canonical status, mapped from whatever the carrier called it.
  status     ShipmentStatus
  message    String?
  location   String?

  /**
   * Carrier event provenance (FR-21.5).
   *
   * `providerEventId` is unique, so a redelivered callback collides on insert
   * and becomes a no-op — the same mechanism the payment webhook uses.
   * `providerStatus` keeps the carrier's own wording, because a mapping that
   * turns out to be wrong is only debuggable if the original survived.
   */
  providerEventId String? @unique
  providerStatus  String?
  /// "manual" | "provider" | "system"
  source          String  @default("manual")
  /// True when this event was recorded but deliberately did not move the
  /// shipment, because it arrived out of order.
  ignoredForStatus Boolean @default(false)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

// ============================================================================
// Returns and refunds (M22)
// ============================================================================

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  COMPLETED
  CANCELLED
}

enum ReturnResolution {
  REFUND
  EXCHANGE
  STORE_CREDIT
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ReturnRequest {
  id           String @id @default(cuid())
  returnNumber String @unique
  orderId      String
  userId       String

  status     ReturnStatus     @default(REQUESTED)
  resolution ReturnResolution @default(REFUND)

  /// Chosen from a fixed list in the UI; free text goes in comment.
  reason  String
  comment String?
  /// Customer-uploaded evidence — storage keys, not raw files.
  images  String[]

  /// Staff-only.
  internalNotes   String?
  /// Shown to the customer when status is REJECTED.
  rejectionReason String?

  /// Return shipping, when the customer sends it back themselves.
  carrier        String?
  trackingNumber String?

  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         ReturnItem[]
  statusHistory ReturnStatusHistory[]
  refunds       Refund[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("return_requests")
}

model ReturnItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int

  /// Set after inspection; drives whether stock goes back on the shelf.
  restock   Boolean @default(false)
  condition String?

  /// Paise this line is worth back: unitPrice × qty minus its share of the
  /// order discount. Frozen at approval so later price edits cannot change it.
  refundableAmount Int @default(0)

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

model ReturnStatusHistory {
  id              String       @id @default(cuid())
  returnRequestId String
  status          ReturnStatus
  note            String?
  changedById     String?
  createdAt       DateTime     @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId, createdAt])
  @@map("return_status_history")
}

/// A refund is money leaving, so it is recorded independently of the return
/// that caused it — admins can also refund an order outright.
model Refund {
  id              String  @id @default(cuid())
  orderId         String
  returnRequestId String?
  /// The gateway refund id, e.g. Razorpay's rfnd_… . Unique so a retried
  /// webhook cannot record the same refund twice.
  providerRefundId String? @unique
  provider         String

  amount   Int
  currency String       @default("INR")
  status   RefundStatus @default(PENDING)
  reason   String?
  /// Gateway response, secrets stripped.
  rawPayload Json?

  initiatedById String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// ============================================================================
// Wishlist (M18) and reviews (M17)
// ============================================================================

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  /// Optional: wishing for a specific size/colour rather than the product.
  variantId String?
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("wishlist_items")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

model Review {
  id        String @id @default(cuid())
  productId String
  userId    String

  /// 1–5, validated at the service layer.
  rating Int
  title  String?
  body   String?
  images String[]

  status             ReviewStatus @default(PENDING)
  /// True when the reviewer has a DELIVERED order containing this product.
  isVerifiedPurchase Boolean      @default(false)

  /// Public reply from the brand.
  adminResponse    String?
  adminRespondedAt DateTime?
  moderatedById    String?
  moderatedAt      DateTime?
  rejectionReason  String?

  helpfulCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One review per customer per product; editing replaces it.
  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([status])
  @@map("reviews")
}

// ============================================================================
// Notifications (M16) and outbound messaging (M14, M15)
// ============================================================================

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

/// In-app bell. userId null = broadcast to all admins (low stock, new order).
model Notification {
  id       String               @id @default(cuid())
  userId   String?
  /// Routing key, e.g. "order.placed", "inventory.low_stock".
  type     String
  title    String
  body     String?
  severity NotificationSeverity @default(INFO)
  /// Where clicking it goes, e.g. "/admin/orders/abc".
  link     String?
  /// Free-form context; never secrets.
  data     Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type])
  @@map("notifications")
}

enum MessageChannel {
  EMAIL
  WHATSAPP
  SMS
  IN_APP
}

model NotificationPreference {
  id      String         @id @default(cuid())
  userId  String
  channel MessageChannel
  /// Same routing key as Notification.type, or "*" for the whole channel.
  type    String
  enabled Boolean        @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, type])
  @@map("notification_preferences")
}

/// Editable templates so copy changes do not need a deploy. {{variables}} are
/// substituted server-side; the allowed set is per-template.
model MessageTemplate {
  id      String         @id @default(cuid())
  key     String
  channel MessageChannel
  name    String
  /// Email only.
  subject String?
  body    String
  /// Provider-approved template name for WhatsApp/SMS.
  providerTemplateId String?
  /// Documents the placeholders this template accepts.
  variables String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs MessageLog[]

  @@unique([key, channel])
  @@map("message_templates")
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  BOUNCED
}

/// Delivery log. Recipients are stored because an order confirmation may go to
/// an address the customer later changes. Never store credentials here.
model MessageLog {
  id         String         @id @default(cuid())
  templateId String?
  channel    MessageChannel
  /// Email address or E.164 phone number.
  recipient  String
  subject    String?
  status     MessageStatus  @default(QUEUED)

  /// Ties a message back to what triggered it, e.g. ("order", "<id>").
  entityType String?
  entityId   String?

  provider          String?
  providerMessageId String?
  error             String?
  attempts          Int     @default(0)

  sentAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  template MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([entityType, entityId])
  @@index([recipient])
  @@map("message_logs")
}

// ============================================================================
// CMS pages and redirects (M23, M25)
// ============================================================================

enum PageStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Page {
  id     String     @id @default(cuid())
  slug   String     @unique
  title  String
  status PageStatus @default(DRAFT)

  /// Same block array shape the homepage sections already use, so the existing
  /// renderer works unchanged.
  blocks Json @default("[]")

  seoTitle       String?
  seoDescription String?
  seoNoindex     Boolean @default(false)
  ogImage        String?

  /// System pages (about, contact, policies) cannot be deleted from admin.
  isSystem Boolean @default(false)

  publishedAt  DateTime?
  scheduledFor DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  revisions PageRevision[]

  @@index([status])
  @@map("pages")
}

/// Immutable snapshot taken before each save, so admins can roll back.
model PageRevision {
  id      String @id @default(cuid())
  pageId  String
  /// Monotonic per page.
  version Int
  title   String
  blocks  Json
  /// Null when the revision was created by a system process.
  createdById String?
  note        String?
  createdAt   DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId, createdAt])
  @@map("page_revisions")
}

/// URL redirects, so renaming a product slug does not strand inbound links.
model Redirect {
  id       String @id @default(cuid())
  /// Path only, leading slash, no host: "/old-product".
  fromPath String @unique
  toPath   String
  /// 301 or 302.
  statusCode Int       @default(301)
  isActive   Boolean   @default(true)
  hitCount   Int       @default(0)
  lastHitAt  DateTime?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive])
  @@map("redirects")
}

// ============================================================================
// Compliance, checkout recovery, account security, CRM
// ============================================================================

/// Consent records for cookies, marketing and terms (DPDP Act). Append-only:
/// withdrawing consent writes a new row with granted = false, so the history of
/// what was agreed and when survives.
model Consent {
  id          String  @id @default(cuid())
  userId      String?
  /// Ties pre-login consent to a browser.
  anonymousId String?
  /// "cookies.analytics", "marketing.email", "terms", "privacy".
  type    String
  granted Boolean
  /// Policy version the customer agreed to.
  version String?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([anonymousId, type])
  @@map("consents")
}

/// One row per checkout attempt. The client sends an idempotency key; a repeat
/// submit finds this row and returns the same order instead of charging twice.
model CheckoutSession {
  id             String  @id @default(cuid())
  idempotencyKey String  @unique
  userId         String
  cartId         String?
  /// Set once the order exists; unique so one session can only ever make one.
  orderId        String? @unique

  /// The request that created it, for debugging mismatched retries.
  payload Json?
  /// Terminal states are "completed" and "failed".
  status  String  @default("started")
  error   String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("checkout_sessions")
}

/// Password reset. Only the SHA-256 of the token is stored, so a database leak
/// does not hand out working reset links — same rule as refresh tokens.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Staff-only notes on a customer record. Never returned on any customer-facing
/// endpoint.
model CustomerNote {
  id       String  @id @default(cuid())
  userId   String
  authorId String?
  body     String
  /// Sticks to the top of the customer page.
  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User  @relation("CustomerNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  author User? @relation("CustomerNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("customer_notes")
}

/// First-party analytics (product views, searches, add-to-cart). Deliberately
/// denormalised and index-light: written on nearly every request, read only by
/// scheduled report queries.
model AnalyticsEvent {
  id          String  @id @default(cuid())
  /// "product.view", "search", "cart.add", "checkout.start".
  type        String
  userId      String?
  anonymousId String?
  sessionId   String?
  entityType  String?
  entityId    String?
  /// Search terms, referrer, UTM parameters. No PII.
  properties  Json?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("analytics_events")
}

// ============================================================================
// Customer showcase — the "as worn by you" video wall
// ============================================================================

enum ShowcaseStatus {
  DRAFT
  /// Publishes automatically once `scheduledFor` passes.
  SCHEDULED
  ACTIVE
  ARCHIVED
}

enum ShowcaseMediaType {
  VIDEO
  IMAGE
}

/// A customer's photo or video of themselves in a piece, shown on the
/// storefront as social proof.
///
/// Curated rather than submitted: an admin adds each item, because this is a
/// marketing surface and an open upload form on the homepage is a moderation
/// problem nobody wants. That is also why it is not the `Review` model —
/// reviews are customer-authored, carry a rating and attach to one product,
/// and moderating them into a video wall would conflate two different jobs.
model ShowcaseItem {
  id String @id @default(cuid())

  mediaType ShowcaseMediaType @default(VIDEO)
  mediaUrl  String
  /// Still frame shown before the video loads.
  ///
  /// Required for video, enforced at the service layer. Four autoplaying
  /// videos with no poster means the largest element on the homepage is
  /// nothing at all until the first frame decodes, which is the difference
  /// between hitting the LCP target and missing it.
  posterUrl String?

  /// Alt text for the image, or a description of the video for anyone who
  /// cannot see it. Required — this is content, not decoration.
  altText String

  caption String?

  // ---- who made it, and whether we may use it ----

  /// Display name, e.g. "Ananya R." Kept short and first-name-plus-initial by
  /// convention; the admin form says so.
  creditName String?
  /// Social handle without the @.
  creditHandle String?
  /// Where it came from, so the permission can be traced back to a real post.
  sourceUrl String?

  /// When permission to use this was obtained.
  ///
  /// The customer owns the video and their own likeness, so publishing without
  /// this is a copyright and personality-rights problem, not a nicety. Nothing
  /// can be set ACTIVE while it is null.
  consentGrantedAt DateTime?
  /// How permission was given — "replied to our comment 12 Aug", "DM screenshot
  /// on file". The evidence, in one line.
  consentNote String?

  status       ShowcaseStatus @default(DRAFT)
  scheduledFor DateTime?
  publishedAt  DateTime?
  /// Ascending. Ties break on createdAt so the order is always total.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ShowcaseProduct[]

  @@index([status, position])
  @@map("showcase_items")
}

/// The pieces visible in a showcase item — "shop this look".
///
/// A join table rather than an array of ids so a deleted product cannot leave
/// a link pointing at nothing.
model ShowcaseProduct {
  showcaseItemId String
  productId      String
  position       Int    @default(0)

  item    ShowcaseItem @relation(fields: [showcaseItemId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([showcaseItemId, productId])
  @@index([productId])
  @@map("showcase_products")
}
