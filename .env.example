NODE_ENV=development

PORT=4000

# Docker / standard local PostgreSQL.
# This machine has neither Docker nor a PostgreSQL install, so backend/.env
# points at the embedded server on 5433 instead. See README.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public

# Generate real values: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

FRONTEND_URL=http://localhost:3000

# Cookie scope. Leave both unset for single-host local development.
# Across subdomains of one domain (shop.example.com + api.example.com) set
# COOKIE_DOMAIN=.example.com and keep SameSite=lax — subdomains are same-site.
# Only use `none` if the two are on genuinely different domains; it forces
# Secure, so HTTPS is required.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Development seed admin. Never commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=change-me

# Payments — server-side only, never exposed to the frontend.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=orders@example.com

# SMS / WhatsApp
SMS_PROVIDER=noop
WHATSAPP_PROVIDER=noop

# Optional — the app runs without Redis.
REDIS_URL=

# local | s3 | r2
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
