{
  "name": "prashki-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prash & Ki commerce API — Express, Prisma, PostgreSQL.",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/with-db.ts prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "tsx scripts/with-db.ts prisma db push --skip-generate --accept-data-loss",
    "db:generate": "prisma generate",
    "db:seed": "tsx scripts/with-db.ts tsx prisma/seed.ts",
    "db:studio": "tsx scripts/with-db.ts prisma studio",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:stop": "tsx scripts/db-stop.ts",
    "db:ping": "tsx scripts/db-ping.ts",
    "setup": "npm run db:push && npm run db:seed",
    "test:smoke": "node scripts/smoke-auth.mjs && node scripts/smoke-admin.mjs && node scripts/smoke-images.mjs && node scripts/smoke-content.mjs && node scripts/smoke-cart.mjs && node scripts/smoke-checkout.mjs && node scripts/smoke-payments.mjs && node scripts/smoke-shipping.mjs && node scripts/smoke-rbac.mjs && node scripts/smoke-ops.mjs && node scripts/smoke-showcase.mjs && node scripts/smoke-messaging.mjs && node scripts/smoke-prd.mjs",
    "test:acceptance": "node scripts/acceptance.mjs",
    "db:bootstrap": "tsx prisma/bootstrap.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "razorpay": "^2.9.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "pino-pretty": "^13.1.3",
    "smtp-server": "^3.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
