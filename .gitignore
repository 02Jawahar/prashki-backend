node_modules/
dist/
*.tsbuildinfo

# Local embedded PostgreSQL clusters
.pgdata/
.pgdata-*/

# Uploaded media — production uses a volume or S3/R2
uploads/*
!uploads/.gitkeep

# Local environment. Only .env.example is committed — .env holds real secrets.
.env
.env.local
.env*.local
# ...and any hand-made copy: .env.backup, .env.old, .env.prod. These hold the
# same secrets as .env and the three patterns above do not match them.
.env.*
!.env.example

.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
